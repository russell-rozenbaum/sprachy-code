{
  "description": "claude-denglisch: per-turn German tutor reminder + silent progress logging",
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/denglisch.py\" prompt", "timeout": 5 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/denglisch.py\" stop", "timeout": 5 }] }
    ]
  }
}
